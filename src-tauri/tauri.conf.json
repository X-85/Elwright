{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elwright",
  "version": "0.1.11",
  "identifier": "com.elwright.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix src run dev",
    "beforeBuildCommand": "npm --prefix src run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Elwright",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../capabilities.json": "capabilities.json",
      "../resources/**/*": "resources/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
