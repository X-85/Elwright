# Elwright 项目忽略规则

# 构建产物
target/
node_modules/
dist/
dist-ssr/
src-tauri/gen/
*.msi
*.dmg

# 依赖锁（按需保留，此处先忽略以减少仓库噪声）
# package-lock.json

# Python 缓存
__pycache__/
*.pyc

# 本地配置（LLM 设置等，用户隐私）
config.local.json
.llm_settings.json

# 编辑器/系统
.vscode/
.DS_Store
*.log

# Playwright e2e 产物（本地跑失败时的截图/trace，不入库）
src/test-results/
src/playwright-report/

# Vitest coverage 输出（HTML 报告含绝对路径，不入库）
src/coverage/
# ZCode 会话工具产物（本机路径/计划文件，不入库）
.zcode/
